rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Tournament data (existing) ───────────────────────────────────────────
    // Restrict to your existing tournament collections as needed.

    // ── BidTrivia Public Leaderboard ─────────────────────────────────────────
    // Public game — anyone can read scores and submit their own score.
    // Documents are created at game start, then updated at game end and when
    // the player submits their name — so both create and update must be allowed.
    match /bidtrivia_leaderboard/{docId} {
      // Anyone can read the leaderboard
      allow read: if true;

      // Create: game session document is initialised when a game starts
      allow create: if true;

      // Update: document is patched when the game ends (score fields) and
      // again when the player submits their name. Delete is not permitted.
      allow update: if true;
    }

    // ProfGuess uses the same public, three-step lifecycle: create at game
    // start, complete at game end, then optionally attach a player name.
    match /profguess/{docId} {
      allow read, create, update: if true;
    }

    // ── Default: deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
